{
  "id": "/leitucast/app-ingrid",
  "name": "LeituCast Ingrid",
  "short_name": "LeituCast",
  "description": "Leia e ouça livros como num livro de verdade. A Lia, sua IA de leitura, encontra clássicos gratuitos do seu gosto, e você também pode importar seus próprios ebooks.",
  "lang": "pt-BR",
  "dir": "ltr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "orientation": "any",
  "background_color": "#100E17",
  "theme_color": "#14111D",
  "categories": [
    "books",
    "education",
    "entertainment",
    "lifestyle"
  ],
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "img/icone-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "img/icone-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "img/icone-adaptavel-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "img/icone-adaptavel-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Continuar lendo",
      "short_name": "Ler",
      "url": "./#inicio",
      "icons": [
        {
          "src": "img/icone-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Minha estante",
      "short_name": "Estante",
      "url": "./#estante",
      "icons": [
        {
          "src": "img/icone-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Perguntar à Lia",
      "short_name": "Lia",
      "url": "./#lia",
      "icons": [
        {
          "src": "img/icone-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Buscar livros",
      "short_name": "Buscar",
      "url": "./#busca",
      "icons": [
        {
          "src": "img/icone-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ]
}
